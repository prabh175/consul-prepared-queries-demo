# Terraform state — contains all resource IDs, IPs, and secrets
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Terraform vars — contains real IPs, VPC IDs, key names, operator CIDRs
terraform.tfvars

# Terraform plugin cache — regenerated by terraform init
.terraform/

# SSH keys
*.pem
*.key

# Consul Enterprise license
*.hclic

# Consul / ESM binaries
*.zip

# macOS
.DS_Store
