# Copy to terraform.tfvars (gitignored).

aws_region   = "us-west-2"
project_name = "consul-pq-demo"
vpc_cidr     = "10.20.0.0/16"   # default — change only if this CIDR conflicts in your account

ssh_key_name         = "your-keypair-us-west-2"
operator_public_cidr = "1.2.3.4/32"  # your laptop: curl -s ifconfig.me
bastion_public_cidr  = ""            # bastion host IP/32, or leave empty

# VPC peering — fill in after: terraform -chdir=terraform/dc3 output -raw peering_connection_id
peer_connection_id = ""              # dc3 peering_connection_id output
peer_vpc_cidr      = "10.10.0.0/16" # must match dc3 vpc_cidr

consul_server_instance_type = "t3.small"
hashicups_instance_type     = "t3.micro"

hashicups_service_counts = {
  postgres    = 1
  product-api = 3
  payments    = 1
  public-api  = 1
  frontend    = 1
}

route53_public_zone_name = "prabhjit-singh.sbx.hashidemos.io"   # records created as *.dc4.<zone>

# Set true to allocate an Elastic IP for the Consul server — required for
# a stable DC4_CONSUL_EIP value in dnsmasq-dual-dc.conf.
enable_elastic_ip = true
