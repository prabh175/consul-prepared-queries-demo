# DC5 Terraform variables — copy to terraform.tfvars and fill in.
# Run dc3 first: terraform -chdir=terraform/dc3 apply
# Then export the outputs needed here:
#
#   dc3_vpc_id            = $(terraform -chdir=terraform/dc3 output -raw vpc_id)
#   dc3_subnet_ids        = $(terraform -chdir=terraform/dc3 output -json subnet_ids)
#   dc3_security_group_id = $(terraform -chdir=terraform/dc3 output -raw security_group_id)
#
# Also set enable_k8s_partition = true in terraform/dc3/terraform.tfvars before re-applying dc3.

dc3_vpc_id            = "vpc-REPLACE"
dc3_vpc_cidr          = "10.10.0.0/16"
dc3_subnet_ids        = ["subnet-REPLACE-1", "subnet-REPLACE-2", "subnet-REPLACE-3"]
dc3_security_group_id = "sg-REPLACE"

operator_public_cidr  = "YOUR_IP/32"
ssh_key_name          = "devops-keypair"

node_instance_type    = "t3.medium"
eks_version           = "1.32"
